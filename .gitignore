# secrets & personal data
.env

# runtime output
*.log
applications*.csv
apply-state-*.json
.naukri-resume-state.json
*.png

# saved browser sessions (contain logged-in cookies)
.*-chrome-profile/
.*-apply-profile/

# resume / personal docs
*.pdf

# CI secrets: only the encrypted *.enc files are committed; plaintext + passphrase stay local
.ci-passphrase
ci-secrets/*
!ci-secrets/*.enc

# deps
node_modules/
